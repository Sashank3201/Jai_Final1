---
// The persistent control strip: identity, strand switcher, civilian toggle, motion toggle.
// Persisted across ClientRouter navigations so its state and focus survive page changes.
//
// The switcher is a native radio group: arrow keys move between strands, and without JS the
// form submits ?strand=NN, which the boot script honours.
import { profile } from '../../../content/profile.ts';
import { AVAILABLE, DEFAULT_STRAND, STRANDS } from '../../strands/ids.ts';
import { strandTokens } from '../../strands/tokens.ts';
import Voice from '../Voice.astro';

const { person } = profile;
const options = STRANDS.filter((s) => AVAILABLE.includes(s.id));
const proxy = new Set(['03']);
---

<header class="chrome" transition:persist="chrome">
  <div class="chrome__bar">
    <a class="chrome__mark" href="/">
      <svg class="chrome__reg" data-deco aria-hidden="true" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="6.5"></circle>
        <path d="M12 1v22M1 12h22"></path>
      </svg>
      <span class="chrome__name">{person.name}</span>
      <span class="chrome__short" aria-hidden="true">
        {person.shortName}
      </span>
    </a>
    <div class="chrome__colorbar" data-deco aria-hidden="true">
      <i></i>
      <i></i>
      <i></i>
      <i></i>
      <i></i>
      <i></i>
    </div>
    <div class="chrome__toggles">
      <button type="button" class="toggle toggle--motion" data-toggle="motion" aria-pressed="false">
        <Voice k="motionOff" only={['01', '02', '03', '04']} />
      </button>
      <button type="button" class="toggle toggle--civilian" data-toggle="civilian">
        <Voice k="civilianOn" only={['01', '02', '03', '04']} />
        <span data-v="c">Back to the strands</span>
      </button>
    </div>
  </div>

  <form class="switcher" method="get">
    <fieldset>
      <legend class="switcher__legend">
        <Voice k="switcherLabel" only={['01', '02', '03', '04']} />
      </legend>
      <div class="switcher__options">
        {options.map((s) => {
          const t = strandTokens[s.id];
          return (
            <label
              class="switcher__opt"
              data-strand-option={s.id}
              style={`--sw-bg:${t.color.bg};--sw-a:${t.color.ink1};--sw-b:${t.color.ink2};--sw-fg:${t.color.fg}`}
            >
              <input type="radio" name="strand" value={s.id} checked={s.id === DEFAULT_STRAND} />
              <span class="switcher__swatch" aria-hidden="true" />
              <span class="switcher__num">{s.id}</span>
              <span class="switcher__name">
                {s.name}
                {proxy.has(s.id) && <span class="switcher__proxy"> (proxy)</span>}
              </span>
            </label>
          );
        })}
      </div>
      <noscript>
        <button type="submit" class="switcher__apply">
          Apply
        </button>
      </noscript>
    </fieldset>
  </form>
</header>

<style is:global>
  @layer base {
    .chrome__bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem 1rem;
      max-inline-size: var(--measure);
      margin-inline: auto;
      padding: 1rem 1.25rem 0;
    }
    .chrome__mark {
      font-weight: 700;
      color: var(--fg);
      text-decoration: none;
    }
    .chrome__short {
      display: none;
    }
    .chrome__toggles {
      display: flex;
      gap: 0.5rem;
    }
    .toggle {
      padding: 0.375rem 0.75rem;
      border: 1px solid var(--fg);
      border-radius: 4px;
      background: var(--bg);
      color: var(--fg);
      cursor: pointer;
    }
    .toggle--motion,
    .switcher {
      display: none;
    }
  }
</style>
